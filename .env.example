# Copy to .env.local. Set actual values locally and separately in Vercel.
# A publishable key is intentionally public; never use an admin or secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional site URL for OAuth / email redirects; do not rely on client input for redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
